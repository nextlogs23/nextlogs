# Public Firebase web configuration (safe for the browser; protect data with rules)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Firebase Admin service account — server only
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Optional server-only override; defaults to NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET
FIREBASE_STORAGE_BUCKET=

# Vercel Blob — server only. Connect a PRIVATE Blob store to the Vercel project.
# Vercel uses OIDC automatically in production. This token is needed for local development.
BLOB_READ_WRITE_TOKEN=

# Paystack — server only
PAYSTACK_SECRET_KEY=

# Telnyx — server only
TELNYX_API_KEY=
# Ed25519 public key from Telnyx Mission Control (required for webhook verification)
TELNYX_PUBLIC_KEY=
# Messaging profile receiving inbound SMS webhooks
TELNYX_MESSAGING_PROFILE_ID=
# Explicit pricing conversion used by the NGN wallet (review before enabling purchases)
TELNYX_USD_NGN_RATE=
TELNYX_NUMBER_MARKUP_PERCENT=20
# Safety lock. Keep false during development and webhook tests.
TELNYX_PURCHASES_ENABLED=false

# SMSPool alternative verification provider — server only
SMSPOOL_API_KEY=
SMSPOOL_API_URL=https://api.smspool.net
# Explicit USD-to-NGN conversion and retail markup
SMSPOOL_USD_NGN_RATE=
SMSPOOL_MARKUP_PERCENT=20
# Safety lock. Keep false until the complete test report passes.
SMSPOOL_PURCHASES_ENABLED=false
NEXT_PUBLIC_SMSPOOL_CUSTOMER_ENABLED=false

# VTpass / compatible VTU provider — server only
VTU_PROVIDER=vtpass
# sandbox uses https://sandbox.vtpass.com/api; production uses https://vtpass.com/api
VTPASS_ENV=sandbox
# Optional official-host override. Leave blank to derive it from VTPASS_ENV.
VTPASS_API_URL=
VTPASS_API_KEY=
VTPASS_PUBLIC_KEY=
VTPASS_SECRET_KEY=
VTPASS_MARKUP_PERCENT=0
VTPASS_REQUEST_TIMEOUT_MS=15000
# Safety lock. Keep false until sandbox verification and explicit approval.
VTPASS_PURCHASES_ENABLED=false

# Safety and operational controls
SMS_DAILY_PURCHASE_LIMIT=5
MAX_SINGLE_WALLET_FUNDING_MINOR=100000000
MAX_WALLET_BALANCE_MINOR=500000000
