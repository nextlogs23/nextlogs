# Public Firebase web configuration (safe for the browser; protect data with rules)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Firebase Admin service account — server only
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Optional server-only override; defaults to NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET
FIREBASE_STORAGE_BUCKET=

# Vercel Blob — server only. Connect a PRIVATE Blob store to the Vercel project.
# Vercel uses OIDC automatically in production. This token is needed for local development.
BLOB_READ_WRITE_TOKEN=

# Paystack — server only
PAYSTACK_SECRET_KEY=

# Manual-funding email alerts — server only (Resend)
# Verify your sending domain in Resend, then use an address on that domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Nextlogs <notifications@your-domain.com>"
MANUAL_FUNDING_NOTIFICATION_EMAIL=nextlog23@gmail.com

# Telnyx — server only
TELNYX_API_KEY=
# Ed25519 public key from Telnyx Mission Control (required for webhook verification)
TELNYX_PUBLIC_KEY=
# Messaging profile receiving inbound SMS webhooks
TELNYX_MESSAGING_PROFILE_ID=
# Explicit pricing conversion used by the NGN wallet (review before enabling purchases)
TELNYX_USD_NGN_RATE=
TELNYX_NUMBER_MARKUP_PERCENT=20
# Safety lock. Keep false during development and webhook tests.
TELNYX_PURCHASES_ENABLED=false

# SMSPool alternative verification provider — server only
# Migration safety lock: old providers cannot accept new purchases unless this
# and their individual purchase flags are both explicitly enabled.
LEGACY_SMS_PROVIDERS_ENABLED=false
SMSPOOL_API_KEY=
SMSPOOL_API_URL=https://api.smspool.net
# Explicit USD-to-NGN conversion and retail markup
SMSPOOL_USD_NGN_RATE=
SMSPOOL_MARKUP_PERCENT=20
# Safety lock. Keep false until the complete test report passes.
SMSPOOL_PURCHASES_ENABLED=false

# BloomSMS active verification provider — server only
BLOOMSMS_API_URL=https://bloomsms.com/api/v1
BLOOMSMS_API_KEY=
BLOOMSMS_USD_NGN_RATE=
BLOOMSMS_MARKUP_PERCENT=20
# Safety lock. Keep false until read-only and approved funded tests pass.
BLOOMSMS_PURCHASES_ENABLED=false

# VTUGATE VTU provider — server only. Test and live keys use the same HTTPS host.
VTU_PROVIDER=vtugate
VTUGATE_ENV=test
VTUGATE_API_URL=https://api.vtugate.com
VTUGATE_API_KEY=
VTUGATE_MARKUP_PERCENT=0
VTUGATE_REQUEST_TIMEOUT_MS=15000
# Safety lock. Keep false until test-key verification and explicit approval.
VTUGATE_PURCHASES_ENABLED=false

# Safety and operational controls
SMS_DAILY_PURCHASE_LIMIT=5
MAX_SINGLE_WALLET_FUNDING_MINOR=100000000
MAX_WALLET_BALANCE_MINOR=500000000
