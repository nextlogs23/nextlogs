rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    match /users/{uid} {
      allow read: if owner(uid) || admin();
      allow create: if owner(uid)
        && request.resource.data.role == 'customer'
        && request.resource.data.status == 'active';
      allow update: if owner(uid)
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status;
      allow update, delete: if admin();
    }
    // Financial, order, provider, pricing, rate-limit and audit documents are
    // exclusively accessed through authenticated server routes using Admin SDK.
    match /wallets/{id} { allow read, write: if false; }
    match /walletTransactions/{id} { allow read, write: if false; }
    match /walletFundingIntents/{id} { allow read, write: if false; }
    match /transactions/{id} { allow read, write: if false; }
    match /smsOrders/{id} { allow read, write: if false; }
    match /telnyxSearchOffers/{id} { allow read, write: if false; }
    match /telnyxOrders/{id} { allow read, write: if false; }
    match /purchasedNumbers/{id} { allow read, write: if false; }
    match /inboundMessages/{id} { allow read, write: if false; }
    match /telnyxWebhookEvents/{id} { allow read, write: if false; }
    match /smsPoolOffers/{id} { allow read, write: if false; }
    match /smsPoolOrders/{id} { allow read, write: if false; }
    match /smsPoolRentalOffers/{id} { allow read, write: if false; }
    match /smsPoolRentals/{id} { allow read, write: if false; }
    match /marketplaceProducts/{id} { allow read, write: if false; }
    match /marketplaceOrders/{id} { allow read, write: if false; }
    match /marketplaceMedia/{id} { allow read, write: if false; }
    match /airtimeOrders/{id} { allow read, write: if false; }
    match /dataOrders/{id} { allow read, write: if false; }
    match /electricityOrders/{id} { allow read, write: if false; }
    match /vtuIdempotency/{id} { allow read, write: if false; }
    match /vtuMeterVerifications/{id} { allow read, write: if false; }
    match /servicePricing/{id} { allow read, write: if false; }
    match /providerConfigurations/{id} { allow read, write: if false; }
    match /platformSettings/{id} { allow read, write: if false; }
    match /notifications/{id} { allow read, write: if false; }
    match /adminAuditLogs/{id} { allow read, write: if false; }
    match /rateLimits/{id} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
